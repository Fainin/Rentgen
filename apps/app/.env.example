VITE_OPENAI_API_KEY=
# Google — live-pan detector + price reconcile (gemini-flash-latest; AI Studio free tier).
VITE_GEMINI_API_KEY=
# Tavily — live used-market comps.
VITE_TAVILY_API_KEY=
