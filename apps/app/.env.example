# Copy to `.env` and fill in. NEVER commit `.env` (it's gitignored).
#
# Demo-scoped keys only — rate-limited and rotated after the event (design doc §9).
# Leave blank to run fully offline with mock data (stub adapters).

# Gemini — live-pan frame-batch detection (the default scanner path)
VITE_GEMINI_API_KEY=
# OpenAI — single-photo detection
VITE_OPENAI_API_KEY=
